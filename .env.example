# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to GitHub — it has your secrets in it.

# You'll get this from Supabase once your project is created (Step 2).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Any long random string. You can generate one at https://generate-secret.vercel.app/32
JWT_SECRET=replace-this-with-a-real-random-secret

# Which port the server runs on locally. 4000 is a safe default.
PORT=4000

# Photo/file uploads. Supabase dashboard -> Settings -> API.
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_KEY is the
# "service_role" secret key (NOT the public "anon" key). Also create a
# bucket named "kyf-uploads" under Storage, set it to Public.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key
